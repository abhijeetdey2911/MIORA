# ==============================================================================
# Project JobHunter - Root Environment Configuration Example
# Copy this file to .env before starting the platform: cp .env.example .env
# ==============================================================================

# Application Metadata
PROJECT_NAME="Project JobHunter"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Service Ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Backend Host / Port
HOST="0.0.0.0"
PORT=8000

# CORS Origins (comma-separated or JSON array)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost"

# PostgreSQL Configuration
POSTGRES_SERVER="127.0.0.1"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace_with_secure_password"
POSTGRES_DB="jobhunter"

# Frontend Configuration
VITE_API_URL="http://localhost:8000"

# ==============================================================================
# Phase 3B — AI Resume Intelligence Configuration (Backend Only)
# Supported AI_PROVIDER values: openai | gemini | groq | openrouter | anthropic
# Never expose AI_API_KEY to the frontend.
# ==============================================================================
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_FALLBACK_MODEL=""
GEMINI_FALLBACK_MODEL="gemini-1.5-flash"
AI_BASE_URL=""
AI_TIMEOUT_SECONDS=45.0
AI_MAX_RETRIES=3

# ==============================================================================
# Multi-Agent Orchestration, Celery/Redis & Telegram Notifications (Backend Only)
# ==============================================================================
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/0"
CELERY_TASK_ALWAYS_EAGER=false

# Telegram Bot API (Optional Notification Provider — Never exposed to frontend)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_NOTIFICATIONS_ENABLED=false

# Default Automation & Safety Limits
DEFAULT_MAX_JOBS_PER_RUN=50
DEFAULT_MAX_APPLICATIONS_PER_RUN=10
DEFAULT_MAX_APPLICATIONS_PER_DAY=25
DEFAULT_MAX_RUNTIME_SECONDS=1800
DEFAULT_MAX_API_SPEND_USD=5.0
DEFAULT_MIN_MATCH_SCORE=70
DEFAULT_RETRY_LIMIT=2
DEFAULT_APPROVAL_MODE="manual"
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
