# Project JobHunter Backend Environment Variables Example

PROJECT_NAME="Project JobHunter"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

HOST="0.0.0.0"
PORT=8000

# CORS origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# PostgreSQL Configuration
POSTGRES_SERVER="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="jobhunter"

# Optional direct connection URL (overrides individual POSTGRES_* params)
# DATABASE_URL="postgresql+psycopg://postgres:postgres_secure_password@localhost:5432/jobhunter"

# Phase 3B — AI Resume Intelligence Configuration (Backend Only)
# Supported AI_PROVIDER values: openai | gemini | groq | openrouter | anthropic
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL=""
AI_TIMEOUT_SECONDS=45.0
AI_MAX_RETRIES=2

# Multi-Agent Orchestration, Celery/Redis & Telegram Notifications (Backend Only)
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/0"
CELERY_TASK_ALWAYS_EAGER=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_NOTIFICATIONS_ENABLED=false
DEFAULT_MAX_JOBS_PER_RUN=50
DEFAULT_MAX_APPLICATIONS_PER_RUN=10
DEFAULT_MAX_APPLICATIONS_PER_DAY=25
DEFAULT_MAX_RUNTIME_SECONDS=1800
DEFAULT_MAX_API_SPEND_USD=5.0
DEFAULT_MIN_MATCH_SCORE=70
DEFAULT_RETRY_LIMIT=2
DEFAULT_APPROVAL_MODE="manual"
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
