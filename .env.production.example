# ==============================================================================
# MIORA — Production Environment Configuration (.env.production.example)
#
# INSTRUCTIONS FOR AWS EC2 DEPLOYMENT:
# 1. On your Ubuntu 24.04 server, copy this file to .env:
#      cp .env.production.example .env
# 2. Fill in the required values below (POSTGRES_PASSWORD, AI API key, etc.).
# 3. Restrict permissions to protect credentials:
#      chmod 600 .env
# 4. NEVER commit the .env file or credentials to Git.
# ==============================================================================

# Application Metadata
PROJECT_NAME="MIORA"
VERSION="0.1.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"

# Service Ports (Only Frontend Port 80 is exposed publicly)
FRONTEND_PORT=80

# CORS Origins (Include your EC2 Public IP and domain name if applicable)
# Example: "http://<YOUR_EC2_PUBLIC_IP>,https://<YOUR_DOMAIN>"
CORS_ORIGINS="http://localhost,http://127.0.0.1"

# ==============================================================================
# Database Configuration (PostgreSQL 16)
# ==============================================================================
POSTGRES_DB="miora"
POSTGRES_USER="miora_user"
# REQUIRED: Generate a strong, random password (e.g. openssl rand -hex 24)
POSTGRES_PASSWORD="CHANGE_ME_SECURE_PASSWORD"

# ==============================================================================
# Message Broker & Cache (Redis 7)
# ==============================================================================
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"
CELERY_TASK_ALWAYS_EAGER=false

# ==============================================================================
# File Storage (Persistent Docker Volume)
# ==============================================================================
STORAGE_BACKEND="local"
RESUME_STORAGE_DIR="/app/storage/resumes"

# ==============================================================================
# AI Resume Intelligence & Model Provider (Backend Only)
# Supported AI_PROVIDER values: openai | gemini | groq | anthropic
# ==============================================================================
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-1.5-flash"
AI_FALLBACK_MODEL=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""
AI_BASE_URL=""
AI_TIMEOUT_SECONDS=150.0
AI_MAX_RETRIES=3

# ==============================================================================
# Real-Time Alerts & Notifications (Optional)
# ==============================================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_NOTIFICATIONS_ENABLED=false

# ==============================================================================
# Multi-Agent Automation Safety Controls
# ==============================================================================
DEFAULT_MAX_JOBS_PER_RUN=50
DEFAULT_MAX_APPLICATIONS_PER_RUN=10
DEFAULT_MAX_APPLICATIONS_PER_DAY=25
DEFAULT_MAX_RUNTIME_SECONDS=1800
DEFAULT_MAX_API_SPEND_USD=5.0
DEFAULT_MIN_MATCH_SCORE=70
DEFAULT_RETRY_LIMIT=2
# Mandatory Manual Approval Mode for production safety
DEFAULT_APPROVAL_MODE="manual"
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true

